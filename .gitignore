# ---------------------------------------------------------------------------
# Secrets & credentials — never commit these (see SECURITY.md)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*credentials*.json
*service-account*.json
kubeconfig
*.kubeconfig
password.txt
*.secret
*.secret.yaml

# Terraform (state files can contain secrets in plain text)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
override.tf
override.tf.json

# ---------------------------------------------------------------------------
# Build output & dependencies
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
__pycache__/
*.py[cod]
.venv/
venv/
bin/
obj/
target/
*.class
build/
dist/

# ---------------------------------------------------------------------------
# Logs, backups, OS & editor files
# ---------------------------------------------------------------------------
*.log
*.bak
*.swp
.DS_Store
Thumbs.db
.idea/
.vscode/

# Large binary files (keep the repo small; use releases or object storage)
*.zip
*.gz
*.rar
*.7z
*.tar
*.tgz
*.bz2
*.xz
*.iso
*.mp3
*.mp4
*.mov
*.avi
